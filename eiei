local awc = Instance.new("UICorner") awc.CornerRadius = UDim.new(0, 6) awc.Parent = AddWpBtn

local WpScroll = Instance.new("ScrollingFrame")
WpScroll.Parent = ContainerTp
WpScroll.Size = UDim2.new(0.9, 0, 0, 80)
WpScroll.Position = UDim2.new(0.05, 0, 0, 40)
WpScroll.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
WpScroll.BorderColor3 = Color3.fromRGB(80, 20, 20)
WpScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
WpScroll.ScrollBarThickness = 4
local wpsc = Instance.new("UICorner") wpsc.CornerRadius = UDim.new(0, 6) wpsc.Parent = WpScroll

local function updateWaypointList()
    for _, child in pairs(WpScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local yPos = 2
    for i, cf in ipairs(waypoints) do
        local tpItem = Instance.new("TextButton")
        tpItem.Parent = WpScroll
        tpItem.Size = UDim2.new(1, -6, 0, 28)
        tpItem.Position = UDim2.new(0, 3, 0, yPos)
        tpItem.BackgroundColor3 = Color3.fromRGB(60, 25, 25)
        tpItem.Text = "📍 จุดวาร์ปที่ " .. i
        tpItem.TextColor3 = Color3.fromRGB(255, 200, 200)
        tpItem.TextSize, tpItem.Font = 11, Enum.Font.SourceSansBold
        
        local tic = Instance.new("UICorner") tic.CornerRadius = UDim.new(0, 4) tic.Parent = tpItem
        
        tpItem.MouseButton1Click:Connect(function()
            pcall(function()
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    player.Character.HumanoidRootPart.CFrame = cf
                end
            end)
        end)
        yPos = yPos + 32
    end
    WpScroll.CanvasSize = UDim2.new(0, 0, 0, yPos)
end

AddWpBtn.MouseButton1Click:Connect(function()
    pcall(function()
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(waypoints, player.Character.HumanoidRootPart.CFrame)
            updateWaypointList()
            AddWpBtn.Text = "✅ บันทึกสำเร็จ (" .. #waypoints .. ")"
            task.wait(1)
            AddWpBtn.Text = "➕ บันทึกจุดวาร์ปปัจจุบัน"
        end
    end)
end)


-- ปุ่ม Auto Bid
local BidBtn = Instance.new("TextButton")
BidBtn.Parent = ContainerMain
BidBtn.Size = UDim2.new(0.9, 0, 0, 40)
BidBtn.Position = UDim2.new(0.05, 0, 0, 10)
BidBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
BidBtn.Text = "Auto Bid: OFF"
BidBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
BidBtn.TextSize, BidBtn.Font = 13, Enum.Font.SourceSansBold
local bc = Instance.new("UICorner") bc.CornerRadius = UDim.new(0, 8) bc.Parent = BidBtn

local autoBidState = false
BidBtn.MouseButton1Click:Connect(function()
    autoBidState = not autoBidState
    if autoBidState then
        BidBtn.Text = "Auto Bid: ON"
        BidBtn.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
        BidBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        task.spawn(function()
            while autoBidState do
                pcall(function()
                    local rep = game:GetService("ReplicatedStorage")
                    for _, v in pairs(rep:GetDescendants()) do
                        if v:IsA("RemoteEvent") and v.Name:lower():find("bid") then
                            v:FireServer()
                        end
                    end
                end)
                task.wait(0.3)
            end
        end)
    else
        BidBtn.Text = "Auto Bid: OFF"
        BidBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        BidBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end)

